{
  "name": "elias-pi-config",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky"
  },
  "dependencies": {
    "@narumitw/pi-codex-usage": "0.13.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "husky": "^9.1.7",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "bundledDependencies": [
    "@narumitw/pi-codex-usage"
  ],
  "pi": {
    "extensions": [
      "./src/extensions",
      "./node_modules/@narumitw/pi-codex-usage/src/codex-usage.ts"
    ],
    "skills": [
      "./src/skills"
    ],
    "prompts": [
      "./src/prompts"
    ],
    "themes": [
      "./src/themes"
    ]
  }
}
